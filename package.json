{
  "name": "takao",
  "version": "1.3.0-beta.1",
  "description": "Tako.player — медиаплеер",
  "author": "takao",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "set ELECTRON_RUN_AS_NODE=&& electron .",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "6.3.9",
    "ffmpeg-static": "5.2.0",
    "ffprobe-static": "3.1.0"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.takao.pleer.beta",
    "productName": "Tako.player Beta",
    "executableName": "TakoBeta",
    "directories": {
      "output": "dist"
    },
    "electronLanguages": [
      "ru",
      "en-US"
    ],
    "compression": "maximum",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "ui.js",
      "i18n.js",
      "changelog.js",
      "editor.js",
      "editor.css",
      "index.html",
      "styles.css",
      "assets/**",
      "!node_modules/ffprobe-static/bin/darwin/**",
      "!node_modules/ffprobe-static/bin/linux/**",
      "!node_modules/ffprobe-static/bin/win32/ia32/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Tako.player Beta",
      "artifactName": "Tako.player-Beta-Setup-${version}.${ext}"
    }
  }
}
